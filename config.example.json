{
  "schema_version": 2,
  "opacity": 1.0,
  "inputs": {
    "activity_file": null,
    "font_file": null,
    "background_image_file": null,
    "foreground_image_file": null,
    "video_files": null
  },
  "clip": {
    "start_seconds": null,
    "end_seconds": null,
    "cumulative_origin": "activity_start"
  },
  "timeline": {
    "activity_start_offset_frames": 0,
    "video_joins": []
  },
  "output": {
    "filename": null,
    "width": 1920,
    "height": 1080,
    "fps": 30,
    "background": {
      "mode": "chroma_key",
      "chroma_key_color": "#00FF00"
    },
    "bitrate_mbps": 16
  },
  "dashboards": [
    {
      "id": "speed",
      "source": "speed",
      "unit": "km/h",
      "smoothing": {
        "method": "moving_average",
        "window_seconds": 1.0
      },
      "precision": 1,
      "pad_zeros": true,
      "update_interval_ms": 100,
      "font_size": 128,
      "anchor": {
        "x": 0.25,
        "y": 0.85
      },
      "align": "bottom_center",
      "color": "#FFFFFFFF",
      "shadow": {
        "color": "#000000FF",
        "offset_x": 4,
        "offset_y": 4,
        "blur_radius": 6,
        "opacity": 0.75
      }
    },
    {
      "id": "distance",
      "source": "distance",
      "unit": "km",
      "smoothing": {
        "method": "none"
      },
      "precision": 2,
      "pad_zeros": true,
      "update_interval_ms": 500,
      "font_size": 96,
      "anchor": {
        "x": 0.75,
        "y": 0.85
      },
      "align": "bottom_center",
      "color": "#FFFFFFFF",
      "shadow": {
        "color": "#000000FF",
        "offset_x": 4,
        "offset_y": 4,
        "blur_radius": 6,
        "opacity": 0.75
      }
    },
    {
      "id": "elapsed_time",
      "source": "elapsed_time",
      "unit": "hms",
      "smoothing": {
        "method": "none"
      },
      "precision": 0,
      "pad_zeros": true,
      "update_interval_ms": 1000,
      "font_size": 72,
      "anchor": {
        "x": 0.5,
        "y": 0.1
      },
      "align": "top_center",
      "color": "#FFFFFFFF",
      "shadow": {
        "color": "#000000FF",
        "offset_x": 4,
        "offset_y": 4,
        "blur_radius": 6,
        "opacity": 0.75
      }
    },
    {
      "id": "current_time",
      "source": "current_time",
      "unit": "hms",
      "smoothing": {
        "method": "none"
      },
      "precision": 0,
      "pad_zeros": true,
      "update_interval_ms": 1000,
      "font_size": 72,
      "anchor": {
        "x": 0.5,
        "y": 0.2
      },
      "align": "top_center",
      "color": "#FFFFFFFF",
      "shadow": {
        "color": "#000000FF",
        "offset_x": 4,
        "offset_y": 4,
        "blur_radius": 6,
        "opacity": 0.75
      }
    },
    {
      "type": "trajectory",
      "id": "route",
      "width": 0.3,
      "margin": 0.02,
      "anchor": {
        "x": 0.95,
        "y": 0.05
      },
      "align": "top_right",
      "update_interval_ms": 200,
      "line_width": 8,
      "remaining_color": "#FFFFFF66",
      "completed_color": "#00E676CC",
      "overlap_blend_mode": "uniform",
      "background_color": null,
      "background_corner_radius": 24,
      "marker_image_file": null,
      "marker_scale": 2.0
    },
    {
      "type": "elevation_profile",
      "id": "elevation_profile",
      "width": 0.4,
      "height": 0.2,
      "margin": 0.03,
      "anchor": {
        "x": 0.5,
        "y": 0.95
      },
      "align": "bottom_center",
      "update_interval_ms": 200,
      "line_color": "#FFFFFFFF",
      "line_width": 6,
      "curve_smoothing": 0.6,
      "dot_color": "#00E676FF",
      "dot_size": 16,
      "vertical_line_color": "#FFFFFF99",
      "vertical_line_width": 2,
      "background_color": "#00000066",
      "background_corner_radius": 24
    },
    {
      "type": "heartbeat",
      "id": "heartbeat",
      "width": 0.08,
      "anchor": {
        "x": 0.1,
        "y": 0.5
      },
      "align": "center",
      "heart_image_file": null
    },
    {
      "type": "fill_progress",
      "id": "heart_rate_progress",
      "source": "heart_rate",
      "unit": "bpm",
      "smoothing": {
        "method": "moving_average",
        "window_seconds": 1.0
      },
      "update_interval_ms": 100,
      "width": 0.18,
      "anchor": {
        "x": 0.1,
        "y": 0.6
      },
      "align": "middle_left",
      "min_value": 80,
      "max_value": 180,
      "direction": "left_to_right",
      "clip_granularity": 0,
      "image_file": null
    },
    {
      "type": "radial_progress",
      "id": "power_dial",
      "source": "power",
      "unit": "W",
      "smoothing": {
        "method": "moving_average",
        "window_seconds": 1.0
      },
      "update_interval_ms": 100,
      "width": 0.12,
      "anchor": {
        "x": 0.9,
        "y": 0.6
      },
      "align": "center",
      "min_value": 0,
      "max_value": 400,
      "start_angle": 225,
      "angle_range": 270,
      "clip_granularity": 0,
      "center": {
        "x": 0.5,
        "y": 0.5
      },
      "image_file": null
    },
    {
      "type": "rotation",
      "id": "power_needle",
      "source": "power",
      "unit": "W",
      "smoothing": {
        "method": "moving_average",
        "window_seconds": 1.0
      },
      "update_interval_ms": 100,
      "width": 0.015,
      "anchor": {
        "x": 0.9,
        "y": 0.6
      },
      "align": "center",
      "min_value": 0,
      "max_value": 400,
      "start_angle": 225,
      "angle_range": 270,
      "clip_granularity": 0,
      "center": {
        "x": 0.5,
        "y": 0.5
      },
      "image_file": null
    },
    {
      "type": "grade_level",
      "id": "grade_level",
      "width": 0.08,
      "anchor": {
        "x": 0.5,
        "y": 0.85
      },
      "align": "center",
      "update_interval_ms": 100,
      "angle_smoothing_seconds": 3.0,
      "image_file": null
    }
  ]
}
